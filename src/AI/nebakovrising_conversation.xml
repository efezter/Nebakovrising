    <BehaviorTree name="nebakovrising_patrol_conversation" is_function="1">
        <Variables>
            <Variable name="requested" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="anchorReady" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="mover" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="active" type="_bool" values="true" isPersistent="0" form="single" />
            <Variable name="target" type="vec3" values="" isPersistent="0" form="single" />
            <Variable name="partner" type="wuid" values="" isPersistent="0" form="single" />
            <Variable name="met" type="_bool" values="false" isPersistent="0" form="single" />
            <Variable name="faced" type="_bool" values="false" isPersistent="0" form="single" />
        </Variables>
        <Parameters><Variable name="activityToken" type="_int" values="0" isPersistent="0" form="single" requirementType="In" /></Parameters>
        <Root OneTimeOnly="false" FailState="Recoverable" saveVersion="2">
            <Behavior canSkip="1"><Sequence>
                <ExecuteLua code="data.requested = nebakovrising.Conversations.HasRequest(entity.this.id, data.activityToken)" />
                <IfCondition failOnCondition="false" condition="$requested"><Parallel successMode="Any" failureMode="Any">
                    <Function_nebakovrising_conversation_cancel activityToken="$activityToken" nodeLabel="92000001" />
                    <Sequence>
                        <Function_nebakovrising_stand activityToken="$activityToken" nodeLabel="92000002" />
                        <!-- Both guards physically stand before the mover's destination is selected. -->
                        <ExecuteLua code="local p = nebakovrising.Conversations.Participant(entity.this.id, data.activityToken); data.mover = p ~= nil and p.mover == true" />
                        <IfCondition failOnCondition="false" condition="$mover"><While doFail="false" propagateChildFail="false" condition="$anchorReady == false"><Sequence>
                            <ExecuteLua code="data.anchorReady = nebakovrising.Conversations.AnchorReady(entity.this.id, data.activityToken)" />
                            <Wait duration="'250ms'" timeType="GameTime" doFail="false" />
                        </Sequence></While></IfCondition>
                        <ExecuteLua code="local plan = nebakovrising.Conversations.Prepare(entity, data.activityToken); data.active = plan ~= nil; if plan and plan.target then data.target.x = plan.target.x; data.target.y = plan.target.y; data.target.z = plan.target.z end" />
                        <IfCondition failOnCondition="false" condition="$active"><Sequence>
                            <IfCondition failOnCondition="false" condition="$mover"><Sequence>
                                <StanceElement smartObject="" stance="standing" allowAny="false" enabled="true">
                                    <MoveParamsDecorator speed="Walk" pathFindingParams="" doorClosingPolicy="Automatic">
                                        <Move stopWithinDistance="0.350000" stopDistanceVariation="0.100000" rayCasteFlee="false" successDistance="0.000000" changeNPCState="false" fastForwardIncludesMove="false" destinationSpecification="$target" destinationSpecification2="" destinationSpecification3="" speed="Walk" additionalParams="" pathFindingParams="" staminaPolicy="" pathInfo="" />
                                    </MoveParamsDecorator>
                                </StanceElement>
                                <ExecuteLua code="data.active = nebakovrising.Conversations.Arrived(entity, data.activityToken)" />
                            </Sequence></IfCondition>
                            <While doFail="false" propagateChildFail="false" condition="$met == false"><Sequence>
                                <ExecuteLua code="data.met = nebakovrising.Conversations.HasMet(entity, data.activityToken)" />
                                <Wait duration="'100ms'" timeType="GameTime" doFail="false" />
                            </Sequence></While>
                            <ExecuteLua code="data.partner = nebakovrising.Conversations.Partner(entity, data.activityToken)" />
                            <While doFail="false" propagateChildFail="false" condition="$faced == false"><Sequence>
                                <ExecuteLua code="nebakovrising.Conversations.TurnStep(entity, data.activityToken)" />
                                <Wait duration="'100ms'" timeType="GameTime" doFail="false" />
                                <ExecuteLua code="data.faced = nebakovrising.Conversations.Faced(entity, data.activityToken)" />
                            </Sequence></While>
                            <While doFail="false" propagateChildFail="false" condition="$active"><Sequence>
                                <Wait duration="'250ms'" timeType="GameTime" doFail="false" />
                                <ExecuteLua code="data.active = nebakovrising.Conversations.ParticipantAlive(entity.this.id, data.activityToken)" />
                            </Sequence></While>
                        </Sequence></IfCondition>
                    </Sequence>
                </Parallel></IfCondition>
            </Sequence></Behavior>
        </Root><ForestContainer /><EditorData EventSet=""><Variables /><ForwardDeclarations /></EditorData>
    </BehaviorTree>
</BehaviorTrees>
